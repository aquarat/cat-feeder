(version 1)
# JLCPCB 2-layer 1 oz FACTORY MINIMA (capabilities page retrieved 2026-10-25)
(rule "JLC min clearance" (constraint clearance (min 0.1mm)))
(rule "JLC min track" (constraint track_width (min 0.1mm)))
(rule "JLC via hole" (condition "A.Type == 'Via'") (constraint hole_size (min 0.15mm)))
(rule "JLC via diameter" (condition "A.Type == 'Via'") (constraint via_diameter (min 0.25mm)))
(rule "JLC via annular" (condition "A.Type == 'Via'") (constraint annular_width (min 0.05mm)))
(rule "JLC PTH annular abs" (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'") (constraint annular_width (min 0.18mm)))
(rule "JLC NPTH min" (condition "A.Pad_Type == 'NPTH, mechanical'") (constraint hole_size (min 0.5mm)))
(rule "JLC PTH min hole" (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'") (constraint hole_size (min 0.15mm)))
(rule "JLC via-via hole" (condition "A.Type == 'Via' && B.Type == 'Via'") (constraint hole_to_hole (min 0.2mm)))
(rule "JLC pad hole-hole" (condition "A.Type == 'Pad' || B.Type == 'Pad'") (constraint hole_to_hole (min 0.45mm)))
(rule "JLC hole clearance via" (condition "A.Type == 'Via'") (constraint hole_clearance (min 0.2mm)))
(rule "JLC hole clearance PTH" (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'") (constraint hole_clearance (min 0.28mm)))
(rule "JLC edge" (constraint edge_clearance (min 0.2mm)))
(rule "JLC silk-pad" (layer "?.Silkscreen") (condition "B.Type == 'Pad'") (constraint silk_clearance (min 0.15mm)))
(rule "JLC text height" (layer "?.Silkscreen") (constraint text_height (min 1.0mm)))
(rule "JLC text thickness" (layer "?.Silkscreen") (constraint text_thickness (min 0.15mm)))
